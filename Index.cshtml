@model IEnumerable<Employee>
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Employees</h1><a class="btn btn-primary" asp-action="Create">Add Employee</a></div><form method="get" class="d-flex gap-2 mb-3"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search name, email or department"><button class="btn btn-outline-primary">Search</button></form><div class="table-responsive bg-white rounded shadow-sm"><table class="table table-striped mb-0"><thead><tr><th>Name</th><th>Email</th><th>Department</th><th>Salary</th><th>Actions</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.Name</td><td>@e.Email</td><td>@e.Department</td><td>@e.Salary.ToString("N2")</td><td><div class="d-flex gap-2"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@e.Id">Edit</a><form asp-action="Delete" asp-route-id="@e.Id" method="post" onsubmit="return confirm('Delete this employee?')"><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></td></tr>}</tbody></table></div>@if(!Model.Any()){<p class="mt-3">No employees found.</p>}
